# 复制为 .env 后修改
DB_PASSWORD=请改成一个长随机密码
ADMIN_USER=admin
ADMIN_PASSWORD=请改成你的登录密码
# AI 推荐在网页「AI 探索 → ⚙ 设置」中配置（密钥加密存入数据库）。
# 也可在这里预填，作为后备：
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# 加密 AI 密钥用的密钥；不填则由数据库连接串派生。设置后不要再改，否则已保存的密钥需重新填写
APP_SECRET=
# 数据目录（建议放在 SSD 上，如 /mnt/ssd/gastronomique）
DATA_DIR=./data
# 对外端口。用 Tailscale HTTPS 时改为只监听本机：PORT=127.0.0.1:5011（见 README「Tailscale HTTPS」）
PORT=5010
# 通过 HTTPS 访问时设为 true
COOKIE_SECURE=false
MAX_UPLOAD_MB=500
